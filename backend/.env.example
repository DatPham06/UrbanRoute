# Spring Boot đọc file backend/.env theo cú pháp properties: không bọc giá trị bằng dấu nháy.
DB_URL=jdbc:oracle:thin:@//localhost:1521/URBANROUTE
DB_USERNAME=urbanroute
DB_PASSWORD=
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Thay bằng chuỗi ngẫu nhiên ít nhất 32 byte khi dùng dữ liệu thật.
JWT_SECRET=
JWT_TOKEN_TTL=1h

# Database-first: chạy các script trong bộ UrbanRoute-database trước khi khởi động backend.
# Dữ liệu demo tùy chọn nằm trong 04-seed-demo.sql.
APP_DEMO_DATA_ENABLED=false
